# Phase 2 image: husk's fully-hardened profile, network none. This image
# only ever does `import <package>` against files installed by Phase 1 and
# handed to it as a tarball embedded in the driver script -- no host path
# is ever bind-mounted in, same no-bind-mount principle husk and witness
# use for code.
FROM python:3.12-slim

RUN useradd --no-create-home --uid 1000 --shell /usr/sbin/nologin sandboxrunner

# See escrow/sandbox_hook.py for what this does. Unlike Dockerfile.install,
# this image's driver process *is* the one doing `import <package>`
# directly (no subprocess involved), so it runs under plain `python3` --
# see the ENTRYPOINT below -- specifically so this hook is active for that
# top-level process itself.
COPY escrow/sandbox_hook.py /usr/local/lib/python3.12/site-packages/sitecustomize.py

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ESCROW_EVENTS_PATH=/tmp/escrow_events.jsonl

USER sandboxrunner
WORKDIR /tmp

ENTRYPOINT ["python3"]
