# Phase 1 image: install with network allowed. Every other husk hardening
# flag stays on at `docker run` time (non-root, dropped caps, read-only
# rootfs, resource limits, --rm) -- see escrow/_container.py. Network is
# the one flag this phase turns off in the other direction from husk's
# default, because a real `pip install` cannot complete without it.
FROM python:3.12-slim

# Non-root user baked into the image -- same as husk/witness, unconditional
# regardless of what flags a caller passes to docker_runner.
RUN useradd --no-create-home --uid 1000 --shell /usr/sbin/nologin sandboxrunner

# setuptools/wheel are trusted build tooling this image ships with, fetched
# once at image-build time -- not part of vetting any package this tool is
# later pointed at. `--no-build-isolation` (used for every install this
# image runs) relies on them already being present here, so the install
# itself never needs to fetch build tooling from an index.
RUN pip install --no-cache-dir --upgrade setuptools wheel

# See escrow/sandbox_hook.py for what this does and why it's placed here
# under the magic `sitecustomize` name.
COPY escrow/sandbox_hook.py /usr/local/lib/python3.12/site-packages/sitecustomize.py

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ESCROW_EVENTS_PATH=/tmp/escrow_events.jsonl

USER sandboxrunner
WORKDIR /tmp

# `-S`: skip site processing for the driver script itself, so spawning
# `pip` (the driver's own expected, deliberate action) is not itself
# picked up by the watcher. `pip` and everything it spawns in turn run as
# plain `python3` subprocesses with normal site processing, so *they* load
# sitecustomize.py automatically -- see escrow/sandbox_hook.py.
ENTRYPOINT ["python3", "-S"]
